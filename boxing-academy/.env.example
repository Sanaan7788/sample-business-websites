# ─────────────────────────────────────────────────────────────
# Cactus Boxing Gym — environment variables
# Copy to .env.local (dev) / set in Railway (prod). Never commit real values.
# ─────────────────────────────────────────────────────────────

# Database (Railway PostgreSQL) — added in Step 1.0.2
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# Email (Resend) — added when the lead form is wired up
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Cactus Boxing Gym <hello@cactusboxinggym.com>"
GYM_NOTIFY_EMAIL="owner@cactusboxinggym.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Maps (optional — the embed iframe needs no key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Admin (Phase 2)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
